# Orbitly API Server
SERVER_PORT=3003
NODE_ENV=development          # set to `production` on a real deploy — CLERK_SECRET_KEY becomes required then

# PostgreSQL (Docker, port 5437)
DB_HOST=localhost
DB_PORT=5437
DB_NAME=orbitly
DB_USER=orbitly
DB_PASS=orbitly

# Auth — https://clerk.com
# Without this set, the server falls back to a single hardcoded dev user ('jagdeep')
# and skips real auth entirely. Required when NODE_ENV=production (server refuses to
# start without it in that case).
CLERK_SECRET_KEY=sk_test_your_key_here
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Deploy URL — used for Clerk's authorizedParties check (prod only) and email links
APP_URL=https://your-deployed-domain.example
# CORS allowlist for the API — comma-separated origin(s) allowed to call it in prod
ALLOWED_ORIGIN=https://your-deployed-domain.example

# Error tracking — https://sentry.io (optional; errors just log to console if unset)
SENTRY_DSN=
VITE_SENTRY_DSN=

# Product analytics — https://posthog.com (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Billing — https://dashboard.stripe.com (optional; billing routes 503 if unset)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_key_here

# Transactional email — https://resend.com (used for household invite emails)
RESEND_API_KEY=your_key_here

# Cricket — https://cricapi.com (free: 100 calls/day, register for key)
CRICAPI_KEY=your_key_here

# Football — https://football-data.org (free: 10 req/min, register for key)
FOOTBALL_DATA_KEY=your_key_here

# NBA — https://balldontlie.io (free tier, register for key)
BALLDONTLIE_API_KEY=your_key_here

# Nager.Date (holidays) and Jolpica F1 are free with no key required

# AI file extraction (prescriptions & test results)
# Ollama runs locally — falls back to Gemini when unavailable (e.g. in production)
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=gemma3:4b
GEMINI_API_KEY=your_key_here   # https://aistudio.google.com — free, no credit card
