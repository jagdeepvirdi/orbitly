# Orbitly API Server
SERVER_PORT=3003

# PostgreSQL (Docker, port 5437)
DB_HOST=localhost
DB_PORT=5437
DB_NAME=orbitly
DB_USER=orbitly
DB_PASS=orbitly

# Cricket — https://cricapi.com (free: 100 calls/day, register for key)
CRICAPI_KEY=your_key_here

# Football — https://football-data.org (free: 10 req/min, register for key)
FOOTBALL_DATA_KEY=your_key_here

# Nager.Date (holidays) and Jolpica F1 are free with no key required

# AI file extraction (prescriptions & test results)
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=gemma3:4b
GEMINI_API_KEY=your_key_here   # https://aistudio.google.com — free, no credit card
